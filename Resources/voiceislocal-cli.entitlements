<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Hardened-runtime entitlements for the bundled voiceislocal tool (Contents/MacOS/voiceislocal). The app
     starts it as the meeting recorder, so it opens the microphone itself; the hardened runtime blocks that
     unless the entitlement below is present. -->
<dict>
    <key>com.apple.security.device.audio-input</key><true/>
</dict>
</plist>
